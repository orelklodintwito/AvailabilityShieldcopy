NODE_ENV=production

# Keep the protected app behind the gateway token; the dashboard and gateway
# are the public services.
PROTECTED_APP_PORT=3000
GATEWAY_PORT=4000
PROTECTED_APP_HEALTH_TIMEOUT_MS=1500
FRONTEND_ORIGIN=https://your-domain.example
TRUST_PROXY=true

# MongoDB Atlas connection string. Never commit a real URI or password.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=availabilityshield
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Required in production for changing the protected target from the dashboard.
SHIELD_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional bounded demo simulator. It can target only the included Protected
# App and must never be pointed at a third-party site.
ENABLE_CLOUD_DEMO_SIMULATOR=false
SIMULATION_GATEWAY_TARGET=https://your-gateway.example

# Layer 4 logs remain local to the Windows PyDivert machine.
AVAILABILITYSHIELD_LOG_DIR=C:\ProgramData\AvailabilityShield\logs\layer4

# Optional cloud reporting from the Windows PyDivert agent. Use the same
# secret in the Render Gateway's LAYER4_AGENT_TOKEN environment variable.
LAYER4_GATEWAY_URL=https://availabilityshield-api.onrender.com
LAYER4_AGENT_ID=orel-windows
LAYER4_AGENT_TOKEN=replace-with-a-long-random-agent-token
LAYER4_SYNC_INTERVAL_SECONDS=5
