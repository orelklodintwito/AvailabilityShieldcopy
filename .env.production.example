NODE_ENV=production

# Keep the protected app private; expose only the gateway/reverse proxy publicly.
PROTECTED_APP_PORT=3000
GATEWAY_PORT=4000
PROTECTED_APP_HEALTH_TIMEOUT_MS=1500
FRONTEND_ORIGIN=https://your-domain.example
TRUST_PROXY=true

# Use a persistent Windows path on the VPS, not the repository folder.
AVAILABILITYSHIELD_DB_PATH=C:\ProgramData\AvailabilityShield\data\availabilityshield.db
AVAILABILITYSHIELD_LOG_DIR=C:\ProgramData\AvailabilityShield\logs\layer4
