{
  "name": "availabilityshield",
  "version": "1.0.0",
  "description": "IPS-style DDoS mitigation system for Layer 4 and Layer 7 availability protection",
  "repository": {
    "type": "git",
    "url": "https://github.com/orelklodintwito/AvailabilityShieldcopy.git"
  },
  "bugs": {
    "url": "https://github.com/orelklodintwito/AvailabilityShieldcopy/issues"
  },
  "homepage": "https://github.com/orelklodintwito/AvailabilityShieldcopy#readme",
  "main": "src/protected-app/server.js",
  "scripts": {
    "dev:app": "nodemon --ignore logs/** --ignore captures/** --ignore layer4/*.json src/protected-app/server.js",
    "dev": "npm run dev:all",
    "dev:gateway": "nodemon --ignore logs/** --ignore captures/** --ignore layer4/*.json src/gateway/server.js",
    "dev:layer4": "py -3 layer4/l4_guard.py --mode monitor",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:all": "concurrently --names app,gateway,layer4,frontend \"npm run dev:app\" \"npm run dev:gateway\" \"npm run dev:layer4\" \"npm run dev:frontend\"",
    "install:all": "npm install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start:app": "node src/protected-app/server.js",
    "start:gateway": "node src/gateway/server.js",
    "start:frontend": "npm --prefix frontend run preview -- --host 0.0.0.0 --port 5173",
    "start:layer4": "py -3 layer4/l4_guard.py --mode enforce",
    "start:production": "pm2-runtime start ecosystem.config.cjs --env production",
    "sim:normal": "node simulator/normal-load.js",
    "sim:heavy": "node simulator/heavy-endpoint-abuse.js",
    "sim:flood": "node simulator/http-flood.js",
    "sim:critical": "node simulator/critical-mixed-load.js",
    "sim:compare:heavy": "node simulator/compare-without-with-shield.js",
    "sim:compare:flood": "SCENARIO=flood node simulator/compare-without-with-shield.js",
    "sim:basic-preservation": "node simulator/basic-preservation.js",
    "validate:backend": "node validation/backend-validation.js",
    "validate:backend:edge": "node validation/backend-edge-validation.js",
    "validate:layer4": "node validation/layer4-validation.js",
    "test": "node validation/frontend-validation.js && node validation/unit-validation.js && npm --prefix frontend run test",
    "lint": "npm --prefix frontend run lint",
    "validate:frontend": "npm test && npm run lint && npm --prefix frontend run build",
    "validate:all": "npm run validate:frontend && npm run validate:layer4 && npm run validate:backend:edge && npm run validate:backend",
    "sim:tcp-burst": "node simulator/tcp-connection-burst.js",
    "run:app": "node src/protected-app/server.js",
    "run:gateway": "node src/gateway/server.js",
    "run": "concurrently \"npm run run:app\" \"npm run run:gateway\"",
    "db:inspect": "node tools/db-inspect.js"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "http-proxy-middleware": "^3.0.6",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  },
  "keywords": ["ddos", "availability", "layer4", "layer7", "mitigation"],
  "author": "AvailabilityShield team",
  "license": "ISC"
}
